# Public site URL, used for sitemap and metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Recipient and sender for the contact form and the interest form.
# Nothing is sent until MAIL_FROM, MAIL_TO and either Resend or SMTP are set.
MAIL_FROM=
MAIL_TO=

# Option A: Resend (https://resend.com). Preferred when the API key exists.
RESEND_API_KEY=

# Option B: SMTP. Used only when RESEND_API_KEY is empty.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
